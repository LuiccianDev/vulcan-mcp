# Configuración opcional de red y seguridad para Vulcan MCP
# Copia este archivo a `.env` (ignorado en Git) o define estas variables en tu sistema Windows.

# Host y puerto del Listener interno en Maptek Vulcan 12 Desktop
VULCAN_MCP_HOST=127.0.0.1
VULCAN_MCP_PORT=9877

# Token de autenticación compartido entre el Servidor MCP y el Listener de Vulcan
# Dejar vacío para modo abierto local (127.0.0.1) o definir una clave secreta:
VULCAN_MCP_TOKEN=your-token
